# CLIProxyAPI Management API
CPA_BASE_URL=http://cliproxyapi:8317/v0/management
CPA_CONFIG_FILE=/run/cliproxyapi/config.yaml
STATE_FILE=/data/state.json

# Prefer a dedicated management key here for portable deployments.
# If compose also loads /opt/cliproxyapi/watcher.env, this can stay empty.
CPA_MANAGEMENT_KEY=

# Bark
BARK_URL=https://api.day.app/your_device_key
BARK_GROUP=CPA
BARK_ICON=https://raw.githubusercontent.com/router-for-me/Cli-Proxy-API-Management-Center/main/logo.jpg

# Polling and alert thresholds
POLL_INTERVAL=300
NOTICE_THRESHOLD=50
LOW_THRESHOLD=20
CRITICAL_THRESHOLD=10
NOTIFY_RECOVERY=false
NOTIFY_RESET_REMINDERS=false

# Time and HTTP
TZ_OFFSET_HOURS=8
REQUEST_TIMEOUT=20

# Optional. The Docker example mounts ./keeper.toml here.
KEEPER_CONFIG=/app/keeper.toml
