# CLIProxyAPI Management API
CPA_BASE_URL=http://cliproxyapi:8317/v0/management
CPA_CONFIG_FILE=/run/cliproxyapi/config.yaml
STATE_FILE=/data/state.json

# Prefer a dedicated management key here for portable deployments.
# If your compose also loads /opt/cliproxyapi/watcher.env, you can leave this empty.
CPA_MANAGEMENT_KEY=

# Bark
BARK_URL=https://api.day.app/your_device_key
BARK_GROUP=CPA
BARK_ICON=https://raw.githubusercontent.com/router-for-me/Cli-Proxy-API-Management-Center/main/logo.jpg

# Polling and thresholds
POLL_INTERVAL=300
NOTICE_THRESHOLD=50
LOW_THRESHOLD=20
CRITICAL_THRESHOLD=10
NOTIFY_RECOVERY=true

# Display reset times in UTC+8 by default
TZ_OFFSET_HOURS=8
REQUEST_TIMEOUT=20

# Codex / Claude 5-hour window scheduler
# 07:00 is the daily anchor. Later triggers follow each credential's real reset_at.
IGNITE_ENABLED=true
IGNITE_START_HOUR=7
IGNITE_END_HOUR=22
IGNITE_END_GRACE_MINUTES=30
IGNITE_GRACE_SECONDS=3

# Retry the same credential only. The scheduler never falls back to another account.
IGNITE_FAILURE_RETRY_SECONDS=300
IGNITE_POST_SUCCESS_HOLD_SECONDS=60

# Optional. Leave empty to auto-select Luna for Codex and Haiku for Claude.
IGNITE_CODEX_MODEL=
IGNITE_CLAUDE_MODEL=

# Optional stable display names keyed by CPA auth_index.
# Useful when one provider has multiple accounts.
# Example: {"auth_index_1":"ChatGPT#main","auth_index_2":"ChatGPT#team"}
ACCOUNT_LABELS_JSON={}
